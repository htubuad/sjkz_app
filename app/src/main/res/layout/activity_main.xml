<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/gray_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="阿里云 IoT 设备控制"
                    android:textSize="14sp"
                    android:textColor="@color/gray_400" />
            </LinearLayout>

            <!-- 连接状态小指示器（设置旁） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="4dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/circle_gray"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_disconnected"
                    android:textSize="13sp"
                    android:textColor="@color/gray_600" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_settings"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置" />
        </LinearLayout>

        <!-- 开关控制入口 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnOpenSwitches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <!-- 左侧图标 -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_power"
                    android:background="@drawable/circle_blue"
                    android:padding="12dp"
                    android:contentDescription="开关" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开关控制"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 路独立开关 · 点击进入"
                        android:textSize="13sp"
                        android:textColor="@color/gray_400"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 右侧箭头 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="@color/gray_400" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 温度调节卡片（可折叠） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 标题行（可点击折叠/展开） -->
                <LinearLayout
                    android:id="@+id/layoutTempHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvTempTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌡️ 温度调节"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />

                    <TextView
                        android:id="@+id/tvTempArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="28sp"
                        android:textColor="@color/gray_400" />
                </LinearLayout>

                <!-- 可折叠内容 -->
                <LinearLayout
                    android:id="@+id/layoutTempContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvTempValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="当前温度: 25°C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_600"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <com.iot.control.RotaryKnobView
                        android:id="@+id/knobTemperature"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="拖动旋钮调整温度，松手后自动下发"
                        android:textSize="12sp"
                        android:textColor="@color/gray_400"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 设定值卡片（可折叠） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSetPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 标题行（可点击折叠/展开） -->
                <LinearLayout
                    android:id="@+id/layoutSetPointHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvSetPointTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎯 设定值"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />

                    <TextView
                        android:id="@+id/tvSetPointArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="28sp"
                        android:textColor="@color/gray_400" />
                </LinearLayout>

                <!-- 可折叠内容 -->
                <LinearLayout
                    android:id="@+id/layoutSetPointContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSetPointValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="当前设定值: 0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_600"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etSetPoint"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="输入浮点数"
                            android:textSize="16sp"
                            android:inputType="numberDecimal|numberSigned"
                            android:background="@drawable/edit_bg"
                            android:padding="12dp"
                            android:gravity="center" />

                        <Button
                            android:id="@+id/btnSetPointConfirm"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="确定"
                            android:textSize="15sp"
                            android:backgroundTint="@color/blue_600"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="输入浮点数并点击确定，下发到设备 Field2 字段"
                        android:textSize="12sp"
                        android:textColor="@color/gray_400"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 电源 & 灯控制卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ 电源 &amp; 灯控制"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPower"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="电源: 关"
                        android:textSize="16sp"
                        android:backgroundTint="@color/gray_400"
                        android:textColor="@color/white"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/btnLight"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="灯: 关"
                        android:textSize="16sp"
                        android:backgroundTint="@color/gray_400"
                        android:textColor="@color/white"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 自定义消息下发卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📤 自定义消息下发"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvCustomTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Topic: /k1jrhJxxEiu/SJD_app/user/update"
                    android:textSize="12sp"
                    android:textColor="@color/gray_400"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etCustomPayload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:maxLines="6"
                    android:gravity="top|start"
                    android:hint='{"DeviceID":"001_V1.1.0","Dir":"C>D","power":0,"light":1,"Switches":0,"Field1":0.00,"Field2":0.00}'
                    android:text='{"DeviceID":"001_V1.1.0","Dir":"C>D","power":0,"light":1,"Switches":0,"Field1":0.00,"Field2":0.00}'
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:background="@drawable/edit_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSendCustom"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="发送"
                        android:textSize="15sp"
                        android:backgroundTint="@color/blue_600"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/btnFillTemplate"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="填默认"
                        android:textSize="13sp"
                        android:backgroundTint="@color/gray_400"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 设备最新状态卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📡 接收数据值"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layoutParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvNoData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无数据"
                    android:textSize="14sp"
                    android:textColor="@color/gray_400"
                    android:gravity="center"
                    android:layout_marginVertical="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 日志卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/connection_log"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLog"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清除"
                        android:textSize="13sp"
                        android:textColor="@color/red_500"
                        app:icon="@android:drawable/ic_menu_delete"
                        app:iconSize="16dp"
                        app:iconTint="@color/red_500" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:overScrollMode="never"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="暂无日志"
                        android:textSize="13sp"
                        android:textColor="@color/gray_400"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:longClickable="true" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
