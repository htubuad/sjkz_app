                <item android:offset="0.5" android:color="#FF22C55E" />
                <item android:offset="0.62" android:color="#FF06B6D4" />
                <item android:offset="0.75" android:color="#FF3B82F6" />
                <item android:offset="0.87" android:color="#FF8B5CF6" />
